# Запуск sysmontask так, чтобы терминал не оставался висеть.
#
# GUI-приложение не может рисовать внутри терминала — оно в любом случае
# открывает собственное окно Wayland. setsid отвязывает его от терминала,
# поэтому вкладку можно сразу закрыть, а приложение продолжит работать.
#
# stderr уходит в /dev/null намеренно: sysmontask 1.3.9 засыпает вывод
# строками "some error in netsidepane update" и "PID still exists but it's
# a zombie" — это его собственные необработанные исключения при обходе
# процессов, а не проблема системы. Убери /dev/null, если понадобится
# посмотреть настоящую ошибку.
function sysmontask --description 'Диспетчер задач, отвязанный от терминала'
    setsid /usr/bin/sysmontask $argv >/dev/null 2>&1 &
    disown
end
