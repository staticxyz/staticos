/* История буфера обмена (SUPER+ALT+V, scripts/clipboard_menu.py).
 *
 * Тот же вид, что у лаунчера (config.rasi: стекло, закрытие щелчком мимо),
 * отличия только здесь: значок 64 px — это миниатюра картинки из истории.
 * Размер средний намеренно: высота строки в rofi одна на весь список, и при
 * крупных миниатюрах текстовые строки раздувались (просьба пользователя 19.09.2026).
 */
@import "~/.config/rofi/config.rasi"

listview { lines: 7; }
element { spacing: 14px; padding: 6px 12px; }
element-icon { size: 64px; }
