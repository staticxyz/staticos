    float4(0.3323, 0.4204, 0.3145, 0.4148), float4(0.3835, 0.1556, 0.4451, 0.1556),
    float4(0.6364, 0.0537, 0.6458, 0.0556), float4(0.6458, 0.0556, 0.6583, 0.0722),
    float4(0.6583, 0.0722, 0.6635, 0.0870), float4(0.6635, 0.0870, 0.6635, 0.1019),
    float4(0.7544, 0.7704, 0.7586, 0.7667), float4(0.7586, 0.7667, 0.7597, 0.7574),
    float4(0.7597, 0.7574, 0.7576, 0.7185), float4(0.7576, 0.7185, 0.7544, 0.7148),
    float4(0.9206, 0.2093, 0.9164, 0.2037), float4(0.9164, 0.2037, 0.9101, 0.2167),
    float4(0.9101, 0.2167, 0.9091, 0.2537), float4(0.5298, 0.2185, 0.5841, 0.2185),
    float4(0.5841, 0.2185, 0.5831, 0.2148), float4(0.4922, 0.2278, 0.5078, 0.2278),
    float4(0.5078, 0.2278, 0.5172, 0.1963), float4(0.5172, 0.1963, 0.5246, 0.2019),
    float4(0.3062, 0.3481, 0.2957, 0.3500), float4(0.2957, 0.3500, 0.2894, 0.3685),
    float4(0.2894, 0.3685, 0.2894, 0.3852), float4(0.2894, 0.3852, 0.2936, 0.3944),
    float4(0.7931, 0.7981, 0.7973, 0.7870), float4(0.7973, 0.7870, 0.7973, 0.7667),
    float4(0.7973, 0.7667, 0.7921, 0.7426), float4(0.6040, 0.4778, 0.6604, 0.4722),
    float4(0.5601, 0.3296, 0.5611, 0.3185), float4(0.5611, 0.3185, 0.6061, 0.3167),
};
// SHAPE-END

static float3 srgb2linear(float3 c) {
    float3 lo = c / 12.92;
    float3 hi = pow(max((c + 0.055) / 1.055, 0.0), float3(2.4));
    return lerp(lo, hi, step(float3(0.04045), c));
}

static float seg_d2(float2 p, float2 a, float2 b) {
    float2 ab = b - a, ap = p - a;
    float t = saturate(dot(ap, ab) / max(dot(ab, ab), 1e-9));
    float2 d = ap - ab * t;
    return dot(d, d);
}

static float hash21(float2 p) {
    p = frac(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return frac(p.x * p.y);
}

public float4
fragment_main(float4 color, KittyTextures t, KittyCustomShaderData d) {
    float4 g = d.active_window_geometry;
    if (g.z <= 0.0 || g.w <= 0.0) g = d.central_area;
    if (g.z <= 0.0 || g.w <= 0.0) return color;

    float2 uv = t.pos;
    if (any(uv < g.xy) || any(uv > g.xy + g.zw)) return color;

    // Цвет приходит с домноженной альфой; фон окна дан с alpha=1.
    float a = max(color.a, 1e-3);
    float3 bg = d.active_window_background.rgb;
    float2 px0 = float2(d.viewport_size_pixels) * t.viewport.zw;

    // Гасим фигуру не только ПОД буквами, но и ВОКРУГ них: одиночная проверка
    // оставляла яркие просветы между буквами, и рисунок склеивался с текстом
    // (просьба: «сливается», 28.09.2026). Девять образцов крестом и по диагоналям
    // с шагом в букву: текст рядом хоть в одном — фигура отступает В НОЛЬ.
    float textness = 0.0;
    const float2 taps[9] = { float2(0.0, 0.0),
                             float2(8.0, 0.0),  float2(-8.0, 0.0),
                             float2(0.0, 12.0), float2(0.0, -12.0),
                             float2(8.0, 12.0), float2(-8.0, 12.0),
                             float2(8.0, -12.0), float2(-8.0, -12.0) };
    for (int i = 0; i < 9; ++i) {
        float4 c2 = t.backbuffer.Sample(uv + taps[i] / px0);
        float a2 = max(c2.a, 1e-3);
        textness = max(textness, smoothstep(TEXT_GUARD * 0.25, TEXT_GUARD * 0.8,
                                            distance(c2.rgb / a2, bg)));
    }
    float clear_area = 1.0 - textness;

    float2 q = (uv - g.xy) / g.zw;
    float2 m = (q - float2(0.5, FIG_Y)) / float2(FIG_W, FIG_H) + 0.5;
    if (any(m < -0.03) || any(m > 1.03)) return color;

    // Поправка на форму: расстояния меряем в пространстве, где фигура не
    // растянута, иначе кромка сбоку толще кромки сверху.
    float2 px = float2(d.viewport_size_pixels) * t.viewport.zw;
    float ar = (FIG_W * g.z * px.x) / max(FIG_H * g.w * px.y, 1.0);
    float2 ms = float2(m.x * ar, m.y);

    // Внутри ли тела: чёт-нечет по пересечениям луча с рёбрами многоугольника.
    // Заодно — расстояние до границы, из него кромка и свечение.
    bool inside = false;
    float edge_d2 = 1e9;
    float2 pj = POLY[POLY_N - 1];
    for (int i = 0; i < POLY_N; ++i) {
        float2 pi = POLY[i];
        if ((pi.y > m.y) != (pj.y > m.y)) {
            float xhit = pj.x + (pi.x - pj.x) * (m.y - pj.y) / (pi.y - pj.y);
            if (m.x < xhit) inside = !inside;
        }
        edge_d2 = min(edge_d2, seg_d2(ms, float2(pi.x * ar, pi.y), float2(pj.x * ar, pj.y)));
        pj = pi;
    }
    float edge_d = sqrt(edge_d2);

    // Внутренние линии — только внутри тела, там им и место.
    float line_d = 1e9;
    if (inside) {
        for (int i = 0; i < INNER_N; ++i) {
            float4 s = INNER[i];
            // грубая отбраковка по рамке отрезка
            float2 lo = min(s.xy, s.zw) - float2(LINE_GLOW * 2.0);
            float2 hi = max(s.xy, s.zw) + float2(LINE_GLOW * 2.0);
            if (any(m < lo) || any(m > hi)) continue;
            line_d = min(line_d, seg_d2(ms, float2(s.x * ar, s.y), float2(s.z * ar, s.w)));
        }
        line_d = sqrt(line_d);
    }

    // Дыхание кромки: волна ползёт вверх, как жар над огнём.
    float tm = d.timestamp;
    float breathe = 1.0 - BREATHE + BREATHE *
        (0.5 + 0.5 * sin(tm * 1.3 - m.y * 6.0 + hash21(floor(ms * 24.0)) * 0.8));

    float3 acc = srgb2linear(ACCENT);
    float3 deep = acc * float3(0.35, 0.5, 1.0);

    float add = 0.0;
    float3 col = deep;

    if (inside) {
        // Тело: у кромки плотнее — так фигура выглядит объёмной, а не плоской.
        float body = FILL_A * (0.55 + 0.45 * exp(-edge_d * 22.0));
        add += body;
        // Внутренние линии.
        float lc = 1.0 - smoothstep(LINE_W, LINE_W * 2.4, line_d);
        float lg = exp(-line_d / LINE_GLOW) * 0.4;
        add += (lc + lg) * LINE_A;
        col = lerp(deep, acc, saturate((lc + lg) * 1.4));
    }
    // Кромка со свечением в обе стороны.
    float ec = 1.0 - smoothstep(EDGE_W, EDGE_W * 2.4, edge_d);
    float eg = exp(-edge_d / EDGE_GLOW) * 0.45;
    float edge = (ec + eg) * EDGE_A * breathe;
    add += edge;
    col = lerp(col, lerp(acc, float3(0.85, 0.94, 1.0), ec * 0.7), saturate(edge * 1.6));

    if (add <= 0.004) return color;
    add *= clear_area;              // на тексте и вокруг него — ноль, без остатка
    return float4(color.rgb + col * add, saturate(color.a + add * 0.8));
}
