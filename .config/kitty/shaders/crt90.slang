#language slang 2026
// ЭЛТ-монитор 90-х для kitty. 28.09.2026.
//
// Написан с нуля, на смену штатному crt. У штатного только выпуклость, строки
// развёртки и тон, и он не работает при background_opacity < 1 (так сказано в
// его шапке), а у пользователя прозрачность 0.62. пользователь просил «в стиле 90-х и более
// изогнутее». Отсюда набор примет кинескопа того времени:
//
//   выпуклость     стекло выгнуто, углы экрана скруглены, вокруг тёмная рамка;
//   развёртка      тёмные промежутки между строками, изгибаются вместе со стеклом;
//   маска          вертикальные триады R, G, B — ими светится люминофор;
//   расхождение    к краям каналы слегка разъезжаются, как на старых трубках;
//   свечение       яркое расплывается и пробивает промежутки развёртки;
//   виньетка       края темнее середины;
//   полоса         едва заметная светлая полоса медленно ползёт вниз.
//
// Прозрачность. Цвета в kitty идут с домноженной альфой, поэтому здесь всё
// только затемняется или подмешивается к тому же образцу, а альфа берётся из
// образца как есть. Так прозрачный терминал остаётся прозрачным, а рамка вокруг
// выпуклого стекла — почти непрозрачной, как корпус монитора.

import kitty_custom_shader_types;

// ─── Ручки настройки ───
static const float CURVE      = 0.036;  // выпуклость стекла: 0 — плоский экран.
                                       // 0.17 было перебором: строки у краёв гнулись
                                       // так, что текст не читался (28.09.2026)
static const float CORNER     = 0.022;  // скругление углов экрана
static const float SCANLINE   = 0.26;   // тёмные промежутки развёртки: 0 — нет
static const float SCAN_PX    = 3.0;    // шаг строк развёртки, пикселей
static const float MASK       = 0.08;   // сила RGB-маски люминофора
static const float ABERRATION = 0.7;    // расхождение каналов у самых краёв, пикселей
static const float BLOOM      = 0.20;   // свечение ярких мест
static const float VIGNETTE   = 0.26;   // затемнение к краям
// Зазор между изогнутым стеклом и прямым краем окна заливается ФОНОМ САМОГО
// ТЕРМИНАЛА, затемнённым. Два прежних подхода пользователь забраковал, и оба по делу:
// непрозрачная серая рамка висела по углам серыми пятнами, а полная
// прозрачность открывала там яркие обои, и зазор бросался в глаза ещё сильнее
// (28.09.2026). Фон терминала не спорит ни с окном, ни с обоями: прозрачность
// у него ровно та же, что у остального окна, а затемнение читается как тень
// под краем стекла.
static const float GAP_DIM = 0.30;   // насколько затемнён зазор

// Выпуклость: точку экрана переводим в точку картинки.
//
// Деление на множитель в углу — не украшение, а необходимость. Без него
// искажение РАСТЯГИВАЕТ картинку, край содержимого уезжает за стекло и
// обрезается, а у самой кромки образец берётся снаружи и повторяет последний
// ряд пикселей — строка приглашения двоилась (замечания пользователя 28.09.2026).
// С нормировкой угол картинки приходится ровно на угол экрана: наружу не
// выходим нигде, и ничего не теряется. Середина при этом чуть отдаляется —
// это и читается как выпуклое стекло.
static float2 barrel(float2 uv) {
    float2 c = uv * 2.0 - 1.0;
    float r2 = dot(c, c);
    float k = 1.0 + CURVE * r2 + CURVE * 0.2 * r2 * r2;
    // Нормируем по СЕРЕДИНЕ кромки (r2 = 1), а не по углу. По углу — картинка
    // отодвигается внутрь, и вдоль краёв пропадает полоса: первый столбец
    // символов срезался («ГРАНИЦА» вместо неё, 28.09.2026). По середине кромки
    // края приходятся ровно на края, ничего не теряется; за краем остаются
    // только самые углы, а их и так скрывает скругление стекла.
    float k_edge = 1.0 + CURVE + CURVE * 0.2;                 // r2 = 1 на кромке
    c *= k / k_edge;
    return c * 0.5 + 0.5;
}

// Скруглённый прямоугольник: >0 внутри экрана, <0 снаружи (в долях экрана).
static float screen_mask(float2 s) {
    float2 q = abs(s - 0.5) - (0.5 - CORNER);
    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - CORNER;
    return -d;
}

public float4
fragment_main(float4 color, KittyTextures t, KittyCustomShaderData d) {
    float2 uv = t.pos;
    float2 px = float2(d.viewport_size_pixels) * t.viewport.zw;
    float2 s = barrel(uv);

    // Край стекла со сглаживанием в один-полтора пикселя.
    float inside = smoothstep(0.0, 1.5 / min(px.x, px.y), screen_mask(uv));
    if (inside <= 0.0) return float4(color.rgb * GAP_DIM, color.a);

    // Расхождение каналов растёт к краям: у центра его нет вовсе.
    float2 dir = s - 0.5;
    float2 off = dir * dot(dir, dir) * 4.0 * ABERRATION / px;
    float4 base = t.backbuffer.Sample(s);
    float3 col = float3(t.backbuffer.Sample(s + off).r, base.g, t.backbuffer.Sample(s - off).b);
    float a = base.a;

    // Свечение: четыре соседа на расстоянии двух пикселей, берётся только яркое.
    float2 o = 2.0 / px;
    float3 b = (t.backbuffer.Sample(s + float2(o.x, 0)).rgb + t.backbuffer.Sample(s - float2(o.x, 0)).rgb +
                t.backbuffer.Sample(s + float2(0, o.y)).rgb + t.backbuffer.Sample(s - float2(0, o.y)).rgb) * 0.25;
    col += max(b - 0.30 * a, 0.0) * BLOOM;

    float lum = dot(col, float3(0.299, 0.587, 0.114)) / max(a, 1e-3);

    // Развёртка идёт по координатам КАРТИНКИ, поэтому изгибается вместе со стеклом.
    // Яркие строки у настоящей трубки толще — отсюда поправка на яркость.
    float sy = s.y * px.y;
    float sl = pow(0.5 + 0.5 * cos(6.2831853 * sy / SCAN_PX), 1.4);
    float scan = 1.0 - SCANLINE * (1.0 - sl);
    scan = lerp(scan, 1.0, saturate(lum) * 0.45);

    // Маска люминофора — на самом стекле, по пикселям экрана.
    float k = frac(uv.x * px.x / 3.0);
    float3 mask = float3(1.0 - MASK * 0.5);
    if (k < 0.3333) mask.r = 1.0 + MASK;
    else if (k < 0.6667) mask.g = 1.0 + MASK;
    else mask.b = 1.0 + MASK;

    // Виньетка и бегущая полоса.
    float2 cc = uv * 2.0 - 1.0;
    float vig = 1.0 - VIGNETTE * pow(saturate(length(cc) / 1.4142), 2.2);
    col *= scan * mask * vig;

    // Стык стекла и зазора — плавный, чтобы край не был рваным.
    return lerp(float4(color.rgb * GAP_DIM, color.a), float4(col, a), inside);
}
