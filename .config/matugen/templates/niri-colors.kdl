// Generated by matugen — included from ~/.config/niri/config.kdl.
// Держать в согласии с hypr-colors.sh: та же формула, тот же акцент.
// Активная рамка — непрозрачный насыщенный оттенок акцента: строку active-color ниже после matugen подменяет sensor_colors.py (08.10.2026, по образцу angelOS); без него — акцент на 90%. Неактивная — акцент на ~22%.
layout {
    border {
        width 5
        active-color "#{{colors.primary.default.hex_stripped}}e6"
        inactive-color "#{{colors.primary.default.hex_stripped}}38"
        urgent-color "#9b0000"
    }

    insert-hint {
        color "#{{colors.primary.default.hex_stripped}}55"
    }
}
