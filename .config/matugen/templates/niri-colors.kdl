// Generated by matugen — included from ~/.config/niri/config.kdl.
// Держать в согласии с hypr-colors.sh: та же формула, тот же акцент.
// Активная рамка — акцент на 60% непрозрачности, неактивная — на ~13%.
layout {
    border {
        width 5
        active-color "#{{colors.primary.default.hex_stripped}}99"
        inactive-color "#{{colors.primary.default.hex_stripped}}22"
        urgent-color "#9b0000"
    }

    insert-hint {
        color "#{{colors.primary.default.hex_stripped}}55"
    }
}
