/* Generated by matugen — do not edit */
* {
    bg:       {{colors.surface_container_lowest.default.hex}};
    bg-alt:   {{colors.surface_container_high.default.hex}};
    /* Фон панели «стекло»: тот же bg на 85% плотности (суффикс d9),
       под ним Hyprland размывает обои (layer_rule для rofi). */
    bg-glass: {{colors.surface_container_lowest.default.hex}}f2;
    fg:       {{colors.on_surface.default.hex}};
    fg-alt:   {{colors.on_surface_variant.default.hex}};
    accent:   {{colors.primary.default.hex}};
    accent-fg:{{colors.on_primary.default.hex}};
    /* Тот же акцент с непрозрачностью 16% (суффикс 29 = 0x29/0xFF):
       мягкая подсветка выбранной строки вместо сплошной заливки. */
    accent-soft: {{colors.primary.default.hex}}29;
    urgent:   {{colors.error.default.hex}};
    outline:  {{colors.outline_variant.default.hex}};
}
