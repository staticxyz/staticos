<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by matugen — do not edit.
     GtkSourceView style schemes are separate from the GTK theme, which is why
     Mousepad's text area kept its old colours while the rest of the desktop
     followed the wallpaper. -->
<style-scheme id="matugen" name="Matugen" version="1.0">
  <author>matugen</author>
  <description>Palette generated from the current wallpaper</description>

  <color name="bg"        value="{{colors.surface.default.hex}}"/>
  <color name="bg_alt"    value="{{colors.surface_container.default.hex}}"/>
  <color name="fg"        value="{{colors.on_surface.default.hex}}"/>
  <color name="fg_dim"    value="{{colors.on_surface_variant.default.hex}}"/>
  <color name="faint"     value="{{colors.outline.default.hex}}"/>
  <color name="accent"    value="{{colors.primary.default.hex}}"/>
  <color name="accent_bg" value="{{colors.primary_container.default.hex}}"/>
  <color name="on_accent" value="{{colors.on_primary_container.default.hex}}"/>
  <color name="second"    value="{{colors.secondary.default.hex}}"/>
  <color name="third"     value="{{colors.tertiary.default.hex}}"/>
  <color name="err"       value="{{colors.error.default.hex}}"/>

  <style name="text"                        foreground="fg" background="bg"/>
  <style name="selection"                   foreground="on_accent" background="accent_bg"/>
  <style name="cursor"                      foreground="accent"/>
  <style name="current-line"                background="bg_alt"/>
  <style name="line-numbers"                foreground="faint" background="bg"/>
  <style name="current-line-number"         foreground="accent" background="bg"/>
  <style name="draw-spaces"                 foreground="faint"/>
  <style name="background-pattern"          background="bg_alt"/>
  <style name="bracket-match"               foreground="accent" bold="true"/>
  <style name="bracket-mismatch"            foreground="err" bold="true"/>
  <style name="search-match"                foreground="on_accent" background="accent_bg"/>

  <style name="def:comment"                 foreground="faint" italic="true"/>
  <style name="def:constant"                foreground="second"/>
  <style name="def:string"                  foreground="second"/>
  <style name="def:number"                  foreground="third"/>
  <style name="def:identifier"              foreground="accent"/>
  <style name="def:statement"               foreground="third" bold="true"/>
  <style name="def:type"                    foreground="accent"/>
  <style name="def:preprocessor"            foreground="third"/>
  <style name="def:error"                   foreground="err" bold="true"/>
  <style name="def:warning"                 foreground="third"/>
  <style name="def:note"                    foreground="accent" bold="true"/>
  <style name="def:underlined"              underline="single"/>
  <style name="def:heading"                 foreground="accent" bold="true"/>
  <style name="def:link-destination"        foreground="third" underline="single"/>
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         foreground="accent" bold="true"/>
  <style name="def:list-marker"             foreground="third" bold="true"/>
  <style name="def:keyword"                 foreground="third" bold="true"/>
  <style name="def:operator"                foreground="fg_dim"/>
  <style name="def:function"                foreground="accent"/>
  <style name="def:builtin"                 foreground="second"/>
  <style name="def:special-char"            foreground="third"/>
</style-scheme>
