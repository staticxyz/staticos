{
    // Generated by matugen — do not edit.
    //
    // Sublime сам следит за Packages/User и перечитывает схему на лету, так
    // что новая палитра доезжает в открытый редактор без перезапуска.
    //
    // Роли подобраны так же, как в теме терминала (templates/kitty.conf):
    // подложки — surface_*, текст — on_surface, а смысловые цвета (ошибка,
    // строка, ключевое слово) разведены по оттенкам, чтобы подсветка
    // оставалась читаемой, а не превращалась в одноцветную кашу.
    "name": "Matugen",
    "author": "matugen",
    "variables": {
        "bg":            "{{colors.surface.default.hex}}",
        "bg_low":        "{{colors.surface_container_lowest.default.hex}}",
        "bg_high":       "{{colors.surface_container_high.default.hex}}",
        "fg":            "{{colors.on_surface.default.hex}}",
        "fg_dim":        "{{colors.on_surface_variant.default.hex}}",
        "accent":        "{{colors.primary.default.hex}}",
        "accent_on":     "{{colors.on_primary.default.hex}}",
        "accent2":       "{{colors.secondary.default.hex}}",
        "accent3":       "{{colors.tertiary.default.hex}}",
        "err":           "{{colors.error.default.hex}}",
        "line":          "{{colors.outline.default.hex}}",
        "line_dim":      "{{colors.outline_variant.default.hex}}",
        "sel":           "{{colors.primary_container.default.hex}}"
    },
    "globals": {
        "background": "var(bg)",
        "foreground": "var(fg)",
        "caret": "var(accent)",
        "line_highlight": "var(bg_high)",
        // Не сплошной primary_container: в fidelity-схеме он светлый, и
        // выделенный текст на нём терялся — цвет букв Sublime не меняет.
        "selection": "color(var(accent) alpha(0.30))",
        "selection_border": "var(accent)",
        "inactive_selection": "color(var(accent) alpha(0.15))",
        "misspelling": "var(err)",
        "gutter": "var(bg)",
        "gutter_foreground": "var(line)",
        "guide": "var(line_dim)",
        "active_guide": "var(accent)",
        "stack_guide": "var(line_dim)",
        "highlight": "var(accent3)",
        "find_highlight": "var(accent3)",
        "find_highlight_foreground": "var(bg)",
        "shadow": "color(var(bg_low) alpha(0.6))"
    },
    "rules": [
        { "scope": "comment", "foreground": "var(fg_dim)", "font_style": "italic" },
        { "scope": "string", "foreground": "var(accent3)" },
        { "scope": "constant.numeric", "foreground": "var(accent2)" },
        { "scope": "constant.language", "foreground": "var(accent2)" },
        { "scope": "constant.character.escape", "foreground": "var(accent3)" },
        { "scope": "keyword, storage.type, storage.modifier", "foreground": "var(accent)" },
        { "scope": "keyword.operator", "foreground": "var(fg_dim)" },
        { "scope": "entity.name.function, support.function", "foreground": "var(accent2)" },
        { "scope": "entity.name.class, entity.name.type, support.type, support.class",
          "foreground": "var(accent3)" },
        { "scope": "variable.parameter", "foreground": "var(fg)" },
        { "scope": "variable.function", "foreground": "var(accent2)" },
        { "scope": "entity.name.tag", "foreground": "var(accent)" },
        { "scope": "entity.other.attribute-name", "foreground": "var(accent3)" },
        { "scope": "invalid", "foreground": "var(err)" },
        { "scope": "punctuation", "foreground": "var(fg_dim)" },
        { "scope": "markup.heading", "foreground": "var(accent)", "font_style": "bold" },
        { "scope": "markup.bold", "font_style": "bold" },
        { "scope": "markup.italic", "font_style": "italic" },
        { "scope": "diff.deleted", "foreground": "var(err)" },
        { "scope": "diff.inserted", "foreground": "var(accent2)" }
    ]
}
