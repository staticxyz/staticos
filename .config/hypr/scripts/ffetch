#!/usr/bin/env bash
# fastfetch, который переживает смену обоев.
#
# Обычный fastfetch печатает цвета 24-битными (38;2;R;G;B), а не номерами
# слотов палитры. Текст со слотом перекрашивается задним числом, когда
# терминалу меняют палитру; truecolor — нет, он впечатан в буфер навсегда.
# Поэтому вывод, напечатанный при одних обоях, остаётся их цвета до тех пор,
# пока окно не перезапустят: замерено — на магентовых обоях в окне лежал
# #bbc3ff от прежних синих.
#
# Чинится единственным способом — перерисовкой. Скрипт следит за конфигом
# fastfetch (его переписывает fastfetch_colors.py на каждой смене обоев) и
# перепечатывает вывод, когда конфиг изменился.
#
# inotifywait в системе нет, поэтому опрос mtime. Раз в 2 с, один stat —
# дешевле, чем разбираться с зависимостью.
set -uo pipefail

CONF="$HOME/.config/fastfetch/config.jsonc"
INTERVAL=2

stamp() { stat -c '%Y' "$CONF" 2>/dev/null || echo 0; }

redraw() {
    local rows out
    rows=$(tput lines 2>/dev/null || echo 24)
    # Вывод обрезается по высоте окна и печатается БЕЗ перевода строки в конце.
    # Иначе получается так: fastfetch печатает больше строк, чем помещается,
    # экран прокручивается, и наверх уезжает как раз шапка — имя машины, OS,
    # Host. Обрезка снизу оставляет шапку на месте: для виджета это то, что
    # нужно, а хвост (Swap, палитра) и так наименее важен.
    # --pipe false обязателен: при выводе не в терминал fastfetch сам гасит
    # цвета, а здесь вывод идёт через подстановку команды, то есть в канал.
    # Без этого флага панель получается монохромной.
    # Логотип — по центру СТОЛБЦА СПРАВКИ по вертикали, не окна. Сам fastfetch
    # прижимает его к верху: логотип «висел под потолком» (29.09.2026).
    # Центр по окну тоже пробовали — пользователь вернул центр по справке. Высоты
    # мерим при каждой перерисовке: набор строк справки меняется со временем.
    local lh ih pad
    lh=$(fastfetch --pipe false -s break 2>/dev/null | wc -l)          # один логотип
    ih=$(fastfetch --pipe false --logo none 2>/dev/null | wc -l)       # одна справка
    pad=$(( (ih - lh) / 2 )); [ "$pad" -lt 0 ] && pad=0
    out=$(fastfetch --pipe false --logo-padding-top "$pad" 2>/dev/null | head -n "$rows")
    printf '\033[H\033[2J\033[3J%s' "$out"
}

# Курсор терминала прячем: это виджет, в нём ничего не печатают, а мигающий
# квадрат оставался на картинке (29.09.2026). На выходе — вернуть.
printf '\033[?25l'
trap 'printf "\033[?25h"' EXIT

# Перерисовать и при изменении размера окна: обрезка считается от высоты,
# и после ресайза старая обрезка становится неверной.
resized=1
trap 'resized=1' WINCH

last=""
while :; do
    now="$(stamp)"
    if [ "$now" != "$last" ] || [ "$resized" = 1 ]; then
        last="$now"
        resized=0
        redraw
    fi
    # sleep прерывается сигналом, поэтому WINCH обрабатывается сразу.
    sleep "$INTERVAL" &
    wait $! 2>/dev/null
done
