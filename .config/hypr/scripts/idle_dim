#!/usr/bin/env python3
"""Приглушение экрана по простою (hypridle, listener 0).

    idle_dim dim      приглушить (яркость 55%)
    idle_dim deep     глубокое приглушение: картинка почти чёрная, подсветка
                      ноутбука в ноль, MSI 1%, подсветка клавиатур выключена
                      (и ноутбука, и Razer)
    idle_dim restore  вернуть обычную яркость
    idle_dim off      ВЫКЛЮЧИТЬ экраны (питание, niri) + подсветку клавиатур;
                      повтор ничего не делает (код 2). Кнопка «Погасить» в боте
    idle_dim on       включить экраны и подсветку обратно (и всё, что погасил простой)
    idle_dim hold     (служебное) держит мониторы выключенными, пока есть файл OFF
    idle_dim state    on | off | dim — для статуса в боте

Приглушение пропускается, когда включён Savage Mode вместе с «не отключать
экран». Возврат гаммы делается ВСЕГДА и безусловно: если флаг переключили,
пока экран уже приглушён, он иначе остался бы тёмным.
"""
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from idle_guard import keep_screen_on  # noqa: E402
from game_guard import game_running  # noqa: E402
import screen_gamma  # noqa: E402


BACKLIGHT_SAVE = os.path.expanduser("~/.cache/idle-backlight")
# Подсветка при глубоком приглушении. Экран ноутбука гасится в ноль — замерено,
# что он возвращается мгновенно (это не DPMS, а обычная яркость). Монитору MSI
# оставляем 1%: его яркость идёт по DDC, и если возврат однажды не доедет, при
# нуле пришлось бы лезть к кнопкам монитора.
DEEP_LAPTOP = "0"
DEEP_MSI = "1"
# Контраст MSI при глубоком приглушении: яркость 1 % всё ещё светится, контраст 0
# давит остаток. Запоминается ОТДЕЛЬНЫМ файлом до изменения: потеряй мы общий
# файл, монитор остался бы с нулевым контрастом (09.10.2026).
DEEP_MSI_CONTRAST = "0"
CONTRAST_SAVE = os.path.expanduser("~/.cache/idle-msi-contrast")
MSI = os.path.join(os.path.dirname(os.path.abspath(__file__)), "monitor_brightness.py")
KBD = "rgb:kbd_backlight"   # подсветка клавиатуры ноутбука (см. scripts/kbdlight)


LOG = os.path.expanduser("~/.cache/idle-dim.log")


def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write("%s %s\n" % (time.strftime("%F %T"), msg))
    except OSError:
        pass


def msi_set(kind, value):
    """Поставить яркость/контраст MSI и проверить чтением, до 4 попыток.

    17.10.2026: «Погасить» дважды и сразу «Включить» — MSI остался тусклым
    (яркость 100, контраст 0). setvcp идёт с --noverify, и команда, пришедшая
    вплотную за предыдущей DDC-командой другого процесса, монитором молча
    теряется. Поэтому возврат проверяется и повторяется."""
    pre = ["contrast"] if kind == "contrast" else []
    for i in range(4):
        subprocess.run(["python3", MSI] + pre + ["set", str(value)], capture_output=True)
        time.sleep(0.3)
        r = subprocess.run(["python3", MSI] + pre + ["get"], capture_output=True, text=True)
        got = r.stdout.strip()
        if got.isdigit() and abs(int(got) - int(value)) <= 1:
            return True
        time.sleep(0.5 * (i + 1))
    log("MSI %s %s не встал (последнее чтение %r)" % (kind, value, got))
    return False


def backlight_down():
    """Опустить подсветку обоих экранов, запомнив прежние значения.

    Гамма делает картинку чёрной, но подсветка продолжает гореть — а экран
    выключать нечем: DPMS у нас убран навсегда (однажды экран после него не
    проснулся). Поэтому «глубокое» приглушение ещё и приглушает саму подсветку,
    до 5 %, и никогда до нуля — чтобы было видно, что машина жива.
    """
    # 17.10.2026: второе «глубокое» подряд (кнопка «Погасить» в боте + простой
    # hypridle 600 с) записывало в память уже нулевую яркость, и «Включить» возвращал
    # ноль: экран и клавиатура оставались тёмными. Запомненное не перезаписываем.
    saved = _load_saved()
    # `-m` (машинный вид) — целая строка «устройство,класс,текущее,процент,макс»;
    # `-m g` отдаёт одно число и по нему не узнать, что было (21.09.2026).
    r = subprocess.run(["brightnessctl", "-m"], capture_output=True, text=True)
    cur = r.stdout.strip().splitlines()[0].split(",") if r.stdout.strip() else []
    if r.returncode == 0 and len(cur) > 4:
        saved.setdefault("laptop", cur[2])
        subprocess.run(["brightnessctl", "-q", "set", DEEP_LAPTOP], capture_output=True)

    # Подсветка клавиатуры: гасим совсем, но только если она горела — иначе
    # возврат «включил» бы её там, где пользователь держал её выключенной.
    r = subprocess.run(["brightnessctl", "-d", KBD, "-m"], capture_output=True, text=True)
    kbd = r.stdout.strip().split(",") if r.stdout.strip() else []
    if r.returncode == 0 and len(kbd) > 4 and kbd[2].isdigit() and int(kbd[2]) > 0:
        saved.setdefault("kbd", kbd[2])
        subprocess.run(["brightnessctl", "-d", KBD, "-q", "set", "0"], capture_output=True)
    r = subprocess.run(["python3", MSI, "get"], capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip().isdigit():
        saved.setdefault("msi", r.stdout.strip())
        subprocess.run(["python3", MSI, "set", DEEP_MSI], capture_output=True)
        c = subprocess.run(["python3", MSI, "contrast", "get"], capture_output=True, text=True)
        if c.returncode == 0 and c.stdout.strip().isdigit():
            saved.setdefault("msi_contrast", c.stdout.strip())
            try:
                with open(CONTRAST_SAVE, "w") as f:
                    f.write(saved["msi_contrast"])
            except OSError:
                pass
            subprocess.run(["python3", MSI, "contrast", "set", DEEP_MSI_CONTRAST],
                           capture_output=True)
    razer_down(saved)
    try:
        with open(BACKLIGHT_SAVE, "w") as f:
            json.dump(saved, f)
    except OSError:
        pass


def razer_down(saved):
    """Погасить подсветку устройств Razer, запомнив прежнюю яркость.

    Светится не клавиатура ноутбука (её светодиод rgb:kbd_backlight и так
    выключен), а внешняя Razer — ею правит демон openrazer. Из-за этого первая
    проверка глубокого приглушения оставила клавиатуру гореть (21.09.2026). Ошибки демона глушим: подсветка не должна мешать возврату
    яркости экранов.
    """
    try:
        import openrazer.client as razer
        values = {}
        for dev in razer.DeviceManager().devices:
            try:
                level = float(dev.brightness)
            except Exception:
                continue
            if level > 0 and dev.serial not in (saved.get("razer") or {}):
                values[dev.serial] = level
                dev.brightness = 0
        if values:
            saved["razer"] = {**(saved.get("razer") or {}), **values}
    except Exception:
        pass


def razer_up(saved):
    values = saved.get("razer") or {}
    if not values:
        return
    try:
        import openrazer.client as razer
        for dev in razer.DeviceManager().devices:
            if dev.serial in values:
                try:
                    dev.brightness = values[dev.serial]
                except Exception:
                    pass
    except Exception:
        pass


def _load_saved():
    try:
        with open(BACKLIGHT_SAVE) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        saved = {}
    if not saved.get("msi_contrast"):
        try:
            with open(CONTRAST_SAVE) as f:
                saved["msi_contrast"] = f.read().strip()
        except OSError:
            pass
    return saved


def backlight_up():
    """Вернуть подсветку. Делается всегда, даже если мы её не опускали."""
    try:
        with open(BACKLIGHT_SAVE) as f:
            saved = json.load(f)
    except (OSError, ValueError):
        saved = {}
    if not saved.get("msi_contrast"):            # общий файл потерян — берём отдельный
        try:
            with open(CONTRAST_SAVE) as f:
                saved["msi_contrast"] = f.read().strip()
        except OSError:
            pass
    if saved.get("msi_contrast", "").isdigit():
        msi_set("contrast", saved["msi_contrast"])
        try:
            os.unlink(CONTRAST_SAVE)
        except OSError:
            pass
    if not saved:
        return
    if saved.get("laptop"):
        subprocess.run(["brightnessctl", "-q", "set", saved["laptop"]], capture_output=True)
    if saved.get("msi"):
        msi_set("brightness", saved["msi"])
    if saved.get("kbd"):
        subprocess.run(["brightnessctl", "-d", KBD, "-q", "set", saved["kbd"]],
                       capture_output=True)
    razer_up(saved)
    try:
        os.unlink(BACKLIGHT_SAVE)
    except OSError:
        pass


def dim(level):
    """Приглушение отдаёт screen_gamma: он же держит ночной свет.

    Раньше здесь был `hyprctl hyprsunset gamma` — в сеансе Niri эта команда
    не делает ничего (проверено 21.09.2026), и приглушения не было вовсе.
    """
    screen_gamma.set_dim(level)
    print(screen_gamma.apply_state())


# 17.10.2026, просьба: «только один раз нажатие засчитывалось… экраны должны полностью
# гаснуть, вместе с подсветкой клавы». «Погасить» в боте больше не яркость (DDC MSI
# терял контраст), а питание мониторов через niri. Яркость и контраст не трогаются —
# возвращать нечего. Файл OFF — признак «погашено кнопкой»: пока он есть, второе
# «off» не делает ничего.
# Пользователь: включать — ТОЛЬКО из бота, не от касания. niri будит мониторы от любого
# ввода, и выключить это нельзя (питание в IPC не видно), поэтому «hold» каждые
# 0,25 с снова гасит их через сокет niri. Чтобы касание не мелькнуло картинкой,
# под выключенным питанием ещё гамма в чёрное и подсветка ноутбука в 0.
RUN = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
OFF = os.path.join(RUN, "jarvis-screens-off.json")
HOLD_EVERY = 0.25


def _niri_sock():
    s = os.environ.get("NIRI_SOCKET")
    if s and os.path.exists(s):
        return s
    socks = sorted(f for f in os.listdir(RUN) if f.startswith("niri.wayland-1.") and f.endswith(".sock"))
    return os.path.join(RUN, socks[0]) if socks else None


def hold_off():
    import socket
    req = b'{"Action":{"PowerOffMonitors":{}}}\n'
    while os.path.exists(OFF):
        path = _niri_sock()
        if path:
            try:
                with socket.socket(socket.AF_UNIX) as so:
                    so.settimeout(2)
                    so.connect(path)
                    so.sendall(req)
                    so.recv(256)
            except OSError:
                pass
        time.sleep(HOLD_EVERY)
    return 0


def _niri(action):
    env = dict(os.environ)
    if _niri_sock():
        env["NIRI_SOCKET"] = _niri_sock()
    env.setdefault("WAYLAND_DISPLAY", "wayland-1")
    return subprocess.run(["niri", "msg", "action", action], env=env, capture_output=True,
                          timeout=5).returncode == 0, env


def screens_off():
    if os.path.exists(OFF):
        print("экраны уже погашены")
        return 2
    saved = {}
    r = subprocess.run(["brightnessctl", "-d", KBD, "-m"], capture_output=True, text=True)
    kbd = r.stdout.strip().split(",") if r.stdout.strip() else []
    if r.returncode == 0 and len(kbd) > 4 and kbd[2].isdigit() and int(kbd[2]) > 0:
        saved["kbd"] = kbd[2]
        subprocess.run(["brightnessctl", "-d", KBD, "-q", "set", "0"], capture_output=True)
    razer_down(saved)
    r = subprocess.run(["brightnessctl", "-m"], capture_output=True, text=True)
    cur = r.stdout.strip().splitlines()[0].split(",") if r.stdout.strip() else []
    if r.returncode == 0 and len(cur) > 4 and cur[2] != "0":
        saved["laptop"] = cur[2]
        subprocess.run(["brightnessctl", "-q", "set", "0"], capture_output=True)
    screen_gamma.set_dim("deep")
    screen_gamma.apply_state()
    ok, env = _niri("power-off-monitors")
    with open(OFF, "w") as f:                    # до запуска hold: он живёт, пока файл есть
        json.dump(saved, f)
    w = subprocess.Popen([os.path.abspath(__file__), "hold"], env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    saved["watcher"] = w.pid
    with open(OFF, "w") as f:
        json.dump(saved, f)
    log("off %s niri=%s" % (json.dumps(saved), ok))
    return 0


def screens_on():
    try:
        with open(OFF) as f:
            saved = json.load(f)
        os.unlink(OFF)
    except (OSError, ValueError):
        saved = {}
    pid = saved.get("watcher")                   # сперва снять hold, иначе он погасит снова
    try:
        if pid and "idle_dim" in open("/proc/%d/cmdline" % pid).read():
            os.kill(pid, 15)
    except (OSError, ValueError):
        pass
    time.sleep(HOLD_EVERY)
    ok, _ = _niri("power-on-monitors")
    if saved.get("laptop"):
        subprocess.run(["brightnessctl", "-q", "set", saved["laptop"]], capture_output=True)
    screen_gamma.set_dim("off")
    screen_gamma.apply_state()
    if saved.get("kbd"):
        subprocess.run(["brightnessctl", "-d", KBD, "-q", "set", saved["kbd"]], capture_output=True)
    razer_up(saved)
    if os.path.exists(BACKLIGHT_SAVE) or os.path.exists(CONTRAST_SAVE):
        backlight_up()                           # пока было темно, успел сработать простой
        dim("off")
    log("on %s niri=%s" % (json.dumps(saved), ok))
    return 0


def state():
    if os.path.exists(OFF):
        return "off"
    return "dim" if os.path.exists(BACKLIGHT_SAVE) else "on"


def main():
    what = (sys.argv[1:] or ["dim"])[0]
    if what == "state":
        print(state())
        return 0
    if what == "hold":
        return hold_off()
    # Одно затемнение/возврат за раз: «Включить» сразу после «Погасить» иначе успевал
    # раньше, чем deep дописал память (DDC монитора — секунды), и экран гас насовсем.
    import fcntl
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "idle-dim.lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    if what == "off":
        return screens_off()
    if what == "on":
        return screens_on()
    if os.path.exists(OFF):                      # и restore тоже: включает только бот (on)
        print("экраны выключены кнопкой — до «Включить» в боте ничего не трогаю")
        return 0
    if what == "restore":
        log("restore " + json.dumps(_load_saved()))
        backlight_up()
        dim("off")
        return 0
    if keep_screen_on():
        print("Savage Mode + «не отключать экран» — приглушение пропущено")
        return 0
    if game_running():
        print("идёт игра — приглушение пропущено")
        return 0
    from idle_guard import video_in_focus, hold
    v = video_in_focus()
    if v:                                        # видео в фокусе — экран не трогать (07.10.2026)
        hold("dim")
        print("смотрят видео (%s) — приглушение пропущено" % v)
        return 0
    if what == "deep":
        r = subprocess.run(["brightnessctl", "-m"], capture_output=True, text=True)
        if os.path.exists(BACKLIGHT_SAVE) and ",0,0%," in r.stdout:
            print("уже глубоко приглушено — повтор пропущен")   # второе deep не трогает ничего
            return 0
        dim("deep")
        backlight_down()
        log("deep " + json.dumps(_load_saved()))
        return 0
    dim("soft")
    return 0


if __name__ == "__main__":
    sys.exit(main())
