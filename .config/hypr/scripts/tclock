#!/usr/bin/env bash
# tty-clock в акцентном цвете обоев.
#
# tty-clock умеет взять только слот ANSI (-C 0..7), и ни один из них не равен
# чистому акценту: слоты гармонизированы — их оттенок подтянут к акценту, но не
# совпадает с ним. Поэтому слот 4 подменяется на акцент ТОЛЬКО для этого окна,
# а tty-clock велено брать именно его. Так часы, дата и таймер — одного цвета.
#
# Если запуск идёт из терминала, часы рисуются В ЭТОМ ЖЕ окне: второе окно не
# открывается, и часы не умирают вместе с родительским терминалом. Отдельное
# окно создаётся только когда терминала нет (запуск с бинда, из rofi и т.п.).
set -uo pipefail

ACCENT="$(cat "$HOME/.cache/matugen/vivid.txt" 2>/dev/null)"
[ -z "$ACCENT" ] && ACCENT="#7aa2f7"

if [ -t 1 ]; then
    # Вернуть слот 4 к палитровому значению НА МОМЕНТ ВЫХОДА, а не к тому, что
    # было при запуске: обои могли смениться, пока часы шли. Значение берётся
    # из свежего colors-kitty.conf. OSC 104 тут не годится — он сбрасывает слот
    # к «настроенному» значению, а widget_accent.py правит именно настроенные,
    # так что сброс вернул бы акцент навсегда.
    restore() {
        local back
        back="$(awk '/^color4 /{ print $2 }' \
                    "$HOME/.cache/matugen/colors-kitty.conf" 2>/dev/null)"
        [ -z "$back" ] && back="$(kitty @ get-colors 2>/dev/null |
                                  awk '$1 == "color4" { print $2 }')"
        if [ -n "$back" ]; then
            printf '\033]4;4;%s\007' "$back"
        else
            printf '\033]104;4\007'
        fi
    }
    # Слот приходится не просто выставить, а ПОДДЕРЖИВАТЬ. При смене обоев
    # theme_changer рассылает палитру во все окна kitty разом
    # (`set-colors --all --configured` плюс broadcast_colors.py), и наш
    # подменённый слот 4 затирается палитровым — часы теряли акцент и
    # окрашивались в обычный синий/лиловый цвет темы.
    #
    # Сторож перечитывает vivid.txt и возвращает слот на место. Заодно это
    # означает, что при смене обоев часы меняют цвет вместе со всем
    # остальным, а не остаются на палитре, которая была при запуске.
    watch_accent() {
        local cur last=""
        while :; do
            cur="$(cat "$HOME/.cache/matugen/vivid.txt" 2>/dev/null)"
            [ -z "$cur" ] && cur="$ACCENT"
            # Пишем в терминал, а не в stdout: stdout занят самими часами.
            printf '\033]4;4;%s\007' "$cur" > /dev/tty 2>/dev/null
            [ "$cur" != "$last" ] && last="$cur"
            sleep 2
        done
    }

    # Рисует не tty-clock, а ~/.local/bin/jclock. Причина: tty-clock 2.3
    # центрирует не циферблат, а рамку вместе с датой, и в узком окне
    # промахивается на две-три колонки (замерено 22.09.2026: при ширине 52
    # рисунок в 47 колонок вставал с отступом 4 слева и 1 справа). Ключа,
    # чтобы это поправить, у неё нет, а середину она считает только при
    # запуске. jclock считает её на каждый кадр и слушает SIGWINCH сам.
    #
    # Цифры и цвет те же: глифы 3x5, цвет — ANSI-слот 4, который мы ниже
    # подменяем на акцент обоев. Вернуть tty-clock: замените вызов на
    #   tty-clock -c -s -C 4 "$@"
    trap 'restore; kill "$WATCH_PID" 2>/dev/null' EXIT INT TERM
    printf '\033]4;4;%s\007' "$ACCENT"
    watch_accent &
    WATCH_PID=$!
    "$HOME/.local/bin/jclock" -s -C 4 "$@"
    exit $?
fi

# Своего терминала нет (бинд, rofi): открываем окно и запускаем В НЁМ ЭТОТ ЖЕ
# скрипт, чтобы вместе с часами поехал и сторож слота. Раньше здесь стоял
# прямой вызов tty-clock, и такое окно теряло акцент при первой же смене обоев.
exec kitty --title "tty-clock" -o "color4=$ACCENT" "$0" "$@"
