// Собирается скриптом ~/.config/niri/scripts/dashboard из dashboard.json —
// руками не править. Подключено из config.kdl через include.

window-rule {
    match app-id=r#"^dash-tmatrix$"#
    open-on-workspace "󰜬"
    open-floating true
    open-focused false
    default-column-width { fixed 424; }
    default-window-height { fixed 287; }
    default-floating-position x=17 y=5 relative-to="top-left"
}

window-rule {
    match app-id=r#"^dash-tmatrix2$"#
    open-on-workspace "󰜬"
    open-floating true
    open-focused false
    default-column-width { fixed 420; }
    default-window-height { fixed 284; }
    default-floating-position x=1481 y=4 relative-to="top-left"
}

window-rule {
    match app-id=r#"^dash-date$"#
    open-on-output "DP-4"
    open-floating true
    open-focused false
    default-column-width { fixed 481; }
    default-window-height { fixed 95; }
    default-floating-position x=540 y=-5 relative-to="top-left"
}

