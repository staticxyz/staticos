// ───────────────────────────── ВВОД ─────────────────────────────
// Источник: ~/.config/hypr/input.lua
input {
    keyboard {
        xkb {
            layout "us,ru"
            // misc:typo добавляет типографские знаки на AltGr: длинное тире на
            // AltGr+минус, короткое на AltGr+Shift+минус, стрелки на AltGr+9/0
            // (23.09.2026). Нужна espanso: без этого знака в раскладке она могла
            // вставлять тире только через буфер обмена и портила там картинки.
            // lv3:ralt_switch делает правый Alt настоящим AltGr — без него в раскладке
            // us третий уровень включался только виртуальной клавишей LVL3, которой
            // на клавиатуре нет, и тире набрать было нечем (проверено xkbcli how-to-type).
            // Цена: правый Alt больше не Alt, для сочетаний с Alt — только левый.
            options "grp:alt_shift_toggle,misc:typo,lv3:ralt_switch"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        // Перетаскивание касанием и «замок»: начали тянуть (тап + тап-и-веди или кнопка),
        // упёрлись в край тачпада — палец можно поднять и переставить, выделение не
        // обрывается (04.10.2026, просьба: «на винде выделение продолжалось»). Само
        // «движение у края» как в Windows libinput не умеет — это ближайшая замена.
        drag true
        drag-lock
        // Скорость прокрутки двумя пальцами (04.10.2026, просьба: «скролл на тачпаде
        // слишком резкий»). До этого значения не было вовсе — работал штатный
        // множитель 1,0; в Hyprland (input.lua) его тоже не задавали. 0.5 — вдвое
        // медленнее. Подбирать числом: меньше — плавнее, 1.0 — как было.
        scroll-factor 0.5
    }

    mouse {
        accel-profile "flat"
        // В Hyprland было sensitivity = -0.2 — та же шкала libinput.
        accel-speed -0.2
    }

    // state/mouse-focus = "detached": наведение мыши НЕ забирает фокус
    // клавиатуры. Поэтому focus-follows-mouse не включаем — в ленте она
    // утаскивает вид за курсором (комментарий из input.lua).
    // Если захочется «follow» — раскомментировать:
    // focus-follows-mouse max-scroll-amount="0%"
}
