// ═══════════════════════════════════════════════════════════════════════════
//  niri — конфиг пользователя, перенесённый с Hyprland 0.56 (20.09.2026).
//
//  Источник: ~/.config/hypr/*.lua. Схема клавиш СОХРАНЕНА как у пользователя,
//  а не как по умолчанию в niri. Главное отличие от чужих конфигов:
//      J / K  — колонки влево/вправо   (в niri по умолчанию это H / L)
//      H / L  — рабочие столы          (в niri по умолчанию это U / I)
//  Столы в niri вертикальные, поэтому «влево» = вверх, «вправо» = вниз.
//
//  Hyprland не тронут. Переключение — в списке сессий SDDM при входе.
//  Проверка конфига без запуска:  niri validate -c ~/.config/niri/config.kdl
// ═══════════════════════════════════════════════════════════════════════════
//
//  С 29.09.2026 конфиг разложен по файлам в cfg/ — по одному на раздел. Порядок
//  include ниже ВАЖЕН: он тот же, что был в едином файле, а niri читает
//  подключённое так, будто текст вставлен на место строки include. Поздние
//  правила окон перебивают ранние, палитра matugen идёт сразу за разметкой —
//  всё это держится на порядке. Прежний единый файл: config.kdl.bak.presplit-*.
//
//  Кто что правит программно:
//    niri_state.py   — скругление (window-rules), центрирование (layout),
//                      фокус по наведению (input), прозрачность Obsidian
//                      (window-rules); ищет строки по всем файлам cfg/.
//    waybar_niri.py  — читает gaps из cfg/layout.kdl.
// ═══════════════════════════════════════════════════════════════════════════

include "cfg/input.kdl"
include "cfg/outputs.kdl"
include "cfg/layout.kdl"
include "cfg/blur.kdl"
include "cfg/workspaces.kdl"
include "cfg/autostart.kdl"
include "cfg/misc.kdl"
include "cfg/window-rules.kdl"
include "cfg/layer-rules.kdl"
include "cfg/waybar-blur.kdl"    // размытие под баром — пишет top_bar.py
include "cfg/animations.kdl"
include "cfg/window-fx.kdl"   // эффект открытия/закрытия окон, пишет window_fx.py
include "cfg/binds.kdl"
include "cfg/rec-binds.kdl"   // временные бинды записи экрана (M — микрофон), см. rec_area.sh

// ─── Остаётся В ГЛАВНОМ файле, а не в cfg/ ───
// Подключённые файлы niri СЛИВАЕТ со своими умолчаниями, а главный — заменяет
// ими. Для recent-windows это важно: здесь блок binds ЗАМЕНЯЕТ стандартные
// сочетания переключателя (Alt+Tab), и Alt+Tab остаётся свободным под
// «следующий монитор» (cfg/binds.kdl). Из подключённого файла он лишь добавил
// бы Mod+Tab к стандартным, и Alt+Tab перехватывался бы (29.09.2026).
// Переключатель окон с превью (niri 25.11+). Заменяет
// scripts/window_switcher.sh, который держался на hyprctl clients.
// ALT+TAB намеренно НЕ занят: у пользователя он переключает монитор.
// 05.10.2026: встроенный переключатель отключён — пустой блок binds ЗАМЕНЯЕТ его
// стандартные сочетания. Alt+Tab теперь свой (scripts/alt_tab.py, бинд в cfg/binds.kdl),
// Super+Tab — следующий монитор (пользователь поменял их местами).
recent-windows {
    binds {
    }
}
