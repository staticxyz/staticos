#!/usr/bin/env python3
"""Новый стол рядом с текущим, а не в конце ленты. 21.09.2026.

Замена биндам Hyprland SUPER+CTRL+вверх/вниз (`ws_order.py insert`).

Разница с Hyprland. Там столы существовали сами по себе, их порядок хранился в
файле, а подписи расставлялись символами нулевой ширины. В niri порядок ведёт
сам композитор, и столы динамические: на каждом мониторе всегда есть ровно один
пустой стол, и он всегда последний. Отдельного действия «создать стол» в niri
нет, поэтому берём тот самый пустой с конца и ставим на нужное место штатным
move-workspace-to-index. Своего учёта порядка не нужно вовсе.

Почему именно move-workspace-to-index, а не move-workspace-up в цикле (так было
в первой редакции, 21.09.2026): у края ленты move-workspace-up не упирается, а
переносит стол на СОСЕДНИЙ МОНИТОР. Стоило счёту шагов разойтись с
действительностью — и стол уезжал на второй экран. Здесь место задаётся числом,
перешагнуть край нечем.

Порядок действий важен: СНАЧАЛА перейти на запасной стол, ПОТОМ переносить.
Пустому столу niri не даёт стоять в середине ленты: если он не в фокусе, стол
тут же удаляется, а взамен создаётся новый в конце. Перенос «со стороны», через
--reference, поэтому молча ничего не делает (проверено 21.09.2026: команда
возвращает 0, а лента не меняется, только у запасного стола новый id).

    ws_insert after    новый стол сразу ПОСЛЕ текущего (ниже по ленте niri)
    ws_insert before   новый стол ПЕРЕД текущим (выше)

На ПУСТОМ столе та же клавиша не создаёт ещё один, а просто ведёт по ленте.
Так получается возврат: создали стол справа через L — прежний остался слева,
и H возвращает на него. Уходя, мы освобождаем пустой стол, и niri его убирает,
то есть лента сама смыкается обратно.

Лента в niri вертикальная, поэтому «перед» — это выше, «после» — ниже, хотя
бинды и висят на H/L: так было в Hyprland, где столы шли по горизонтали.

Особенность niri, которой не было в Hyprland: **пустой стол живёт, пока на нём
стоишь.** Уйдёте, не открыв окна, — niri его уберёт, и лента сомкнётся. Стол
закрепляется первым же окном.

Переход на новый стол — как в Hyprland: создали и сразу там.
"""
import json
import subprocess
import sys


def msg(*args):
    r = subprocess.run(["niri", "msg", "--json", *args], capture_output=True, text=True)
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def act(*args):
    subprocess.run(["niri", "msg", "action", *args], capture_output=True)


def main():
    side = sys.argv[1] if len(sys.argv) > 1 else "after"

    ws = msg("workspaces") or []
    cur = next((w for w in ws if w.get("is_focused")), None)
    if not cur:
        return 1
    same = sorted((w for w in ws if w.get("output") == cur.get("output")),
                  key=lambda w: w["idx"])

    wins = msg("windows") or []
    busy = {x.get("workspace_id") for x in wins}

    # Стоим на пустом столе — вставлять рядом нечего, и клавиша просто ведёт по
    # ленте. Отсюда же и возврат: создали стол справа через L, значит прежний
    # остался СЛЕВА, и H возвращает на него (и наоборот). Отдельной памяти о
    # том, откуда мы пришли, не нужно — достаточно того, что новый стол пуст.
    # Уходя, мы его и освобождаем: пустой стол niri убирает сам.
    if cur["id"] not in busy:
        act("focus-workspace-up" if side == "before" else "focus-workspace-down")
        return 0

    # Пустой стол в конце ленты — тот, что niri держит про запас. Именно его и
    # двигаем: создавать столы niri не даёт, а этот уже есть и ничей. Имя —
    # признак стола, заданного руками (и niri такой не удаляет), его не трогаем.
    spare = next((w for w in reversed(same)
                  if w["id"] not in busy and not w.get("name")), None)
    if spare is None:
        return 0

    act("focus-workspace", str(spare["idx"]))

    # Место считаем ЗАНОВО: уйдя с прежнего стола, мы могли оставить пустым
    # какой-то стол выше, niri его удалил, и все номера ниже сместились.
    ws = msg("workspaces") or []
    home = next((w for w in ws if w["id"] == cur["id"]), None)
    if home is None:
        return 0
    target = home["idx"] + 1 if side == "after" else home["idx"]
    act("move-workspace-to-index", str(target))
    return 0


if __name__ == "__main__":
    sys.exit(main())
