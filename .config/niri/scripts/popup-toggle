#!/bin/sh
# Повторное нажатие закрывает всплывашку (23.09.2026).
#
#     popup-toggle КОМАНДА [АРГУМЕНТЫ…]
#
# Все всплывашки на сочетаниях — rofi (меню программ, калькулятор SUPER+C,
# буфер SUPER+ALT+V, помидор SUPER+T). Если rofi уже открыт — любое из этих
# сочетаний его закрывает, а не открывает второй экземпляр поверх; иначе
# запускается команда. pkill -x — по имени процесса, не по строке запуска:
# поиск по строке ловил бы и этот скрипт (в его аргументах та же команда).
#
# Журнал (02.10.2026): Super+Alt+V иногда «ничего не делает», а при проверке всё
# открывается. Чтобы поймать момент — каждое нажатие пишет строку в
# $XDG_RUNTIME_DIR/popup-toggle.log: время, был ли уже rofi, код выхода и ошибки.
LOG="${XDG_RUNTIME_DIR:-/tmp}/popup-toggle.log"
if pgrep -x rofi >/dev/null 2>&1; then
    echo "$(date '+%F %T') rofi уже открыт (pid $(pgrep -x rofi | tr '\n' ' ')) → закрываю; команда: $*" >> "$LOG"
    pkill -x rofi
    exit 0
fi
start=$(date +%s)
"$@" 2>>"$LOG"
rc=$?
echo "$(date '+%F %T') запуск: $* → код $rc за $(( $(date +%s) - start )) с" >> "$LOG"
tail -n 200 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
exit $rc
