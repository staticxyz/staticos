#!/usr/bin/python3 -SE
"""Открыть Настройки (SUPER+/) — быстрый пускатель. 03.10.2026.

Настройки после первого открытия живут спрятанным процессом и слушают сокет
(settings_app.py: ask_resident). Но сам settings_app.py — 300 КБ, и Python разбирает
его целиком ещё до того, как постучаться в сокет: ~165 мс на зажатом процессоре.
Этот файл стучится сам (те же аргументы через \\x1f) и запускает settings_app.py,
только если живого процесса нет. `-S -E` — без site-packages, они тут не нужны.
"""
import os
import socket
import sys

SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "jarvis-settings.sock")
APP = os.path.expanduser("~/.config/hypr/scripts/settings_app.py")
args = sys.argv[1:]
# 09.10.2026: окно уже открыто — просто перейти к нему (на другом столе/мониторе тоже).
# GTK present() из сокета niri фокус не отдаёт (нет токена активации), поэтому — через niri.
if not args:
    import json
    import subprocess
    try:
        wins = json.loads(subprocess.run(["niri", "msg", "-j", "windows"], capture_output=True,
                                         text=True, timeout=2).stdout or "[]")
        win = next((w for w in wins if w.get("app_id") == "com.jarvis.settings"), None)
        if win:
            subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(win["id"])],
                           timeout=2)
            sys.exit(0)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
        c.settimeout(1.5)
        c.connect(SOCK)
        c.sendall(("\x1f".join(args) + "\n").encode())
        if c.recv(16).startswith(b"ok"):
            sys.exit(0)
except OSError:
    pass
if "--quit" in args:
    sys.exit(0)
os.execv("/usr/bin/python3", ["python3", APP] + args)
