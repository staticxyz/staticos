#!/bin/sh
# Бинды раскладки прокрутки, которые ломают стопку окон (21.10.2026, просьба: «убрать бинды от
# режима скроллинга, которые могут поломать систему»): в стопке — молчат, иначе — как было.
# В стопке один общий стол на монитор, окна плавающие, свёрнутые лежат на скрытом столе:
# перенос окна/стола, раскладка Super+A, «в ленту» Super+V и колонки сбили бы её.
#   nostack niri msg action move-column-to-workspace 3
#   nostack python3 …/ws_layout.py cycle
grep -q '"active": true' "$HOME/.config/hypr/state/stack-mode.json" 2>/dev/null && exit 0
exec "$@"
