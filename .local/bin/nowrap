#!/bin/sh
# nowrap — выполнить команду с выключенным автопереносом строк. 23.09.2026
#
# Терминал сам решает, что делать со строкой, которая не влезла в ширину окна:
# по умолчанию переносит хвост на следующую строку (режим DECAWM). Выключаем —
# и хвост просто обрезается по краю окна, а раскладка не разъезжается. Это
# спасает вывод, свёрстанный колонками: fastfetch, fetch3d, таблицы.
#
#   nowrap fastfetch
#   nowrap archfetch --size 1.5
#
# Режим возвращается обратно при любом выходе, включая Ctrl+C: без этого
# терминал остался бы без переноса до конца сеанса.
printf '\033[?7l'
trap 'printf "\033[?7h"' EXIT HUP INT TERM
"$@"
