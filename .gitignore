# Backups and editor leftovers
*.bak
*.bak*
*.v1
*.orig
*.save
*.tmp
*.log
*~
backup*/
backups/
*-backups/

# Python
__pycache__/
*.pyc

# Generated by .config/niri/scripts/waybar_niri.py
.config/waybar/config-niri.jsonc
.config/waybar/style-niri.css
.config/waybar/config-niri-*.jsonc

# Runtime state and generated assets
.config/hypr/state/
.config/niri/state/
.config/hypr/sounds/*
!.config/hypr/sounds/alarm-520hz-t3.wav
.local/bin/x11-clip-events

# Secrets, if you ever add any
.env
*.token
